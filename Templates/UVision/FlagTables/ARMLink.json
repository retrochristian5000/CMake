[
  {
    "comment": "Report 'might fail' Conditions as Errors",
    "path": "LDads/RepFail",
    "default": "0",
    "options": [ "ArmAds" ],
    "modifiers": [
      {
        "flag": "--strict",
        "set": "1"
      }
    ]
  },
  {
    "comment": "Scatter file",
    "path": "LDads/ScatterFile",
    "default": "",
    "options": [ "ArmAds", "ValueIsPath" ],
    "modifiers": [
      {
        "flag": "--scatter",
        "value": "(.*)",
        "set": "$1",
        "options": ["RegexInValue"]
      }
    ]
  },
  {
    "comment": "Use Memory Layout from Target Dialog",
    "path": "LDads/umfTarg",
    "default": "1",
    "options": [ "ArmAds" ],
    "modifiers": [
      {
        "flag": "--scatter",
        "set": "0"
      }
    ]
  },
  {
    "comment": "Linker Listing",
    "path": "TargetOption/TargetArmAds/ArmAdsMisc/AdsLLst",
    "default": "0",
    "modifiers": [
      {
        "flag": "--list",
        "value": ".*",
        "set": "1",
        "options": [ "RegexInValue" ]
      }
    ]
  },
  {
    "comment": "Listing Path",
    "path": "TargetOption/TargetCommonOption/ListingPath",
    "options": [ "ValueIsDirectory" ],
    "modifiers": [
      {
        "flag": "--list",
        "value": "(.*)[\\/][^.]*\\.[^.]+",
        "set": "$1",
        "options": [ "RegexInValue" ]
      }
    ]
  },
