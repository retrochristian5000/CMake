include(Compiler/GNU)
__compiler_gnu(OBJC)


if((NOT DEFINED CMAKE_DEPENDS_USE_COMPILER OR CMAKE_DEPENDS_USE_COMPILER)
    AND CMAKE_GENERATOR MATCHES "Makefiles"
    AND CMAKE_DEPFILE_FLAGS_OBJC AND NOT CMAKE_OBJC_COMPILER_VERSION VERSION_LESS 3.0)
  if (CMAKE_GENERATOR MATCHES "NMake Makefiles")
    # dependencies generated by the compiler, especially when paths hold spaces,
    # are not compatible with NMake tool
  else()
    # dependencies are computed by the compiler itself
    string(PREPEND CMAKE_DEPFILE_FLAGS_OBJC "-MP ")
    set(CMAKE_OBJC_DEPENDS_USE_COMPILER TRUE)
  endif()
endif()
