# Probably needs to match CXX flags more closely
include(Compiler/IntelLLVM)
__compiler_intel(DPCPP)

string(APPEND CMAKE_DPCPP_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
string(APPEND CMAKE_DPCPP_FLAGS_RELEASE_INIT " -DNDEBUG")
string(APPEND CMAKE_DPCPP_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG")

set(CMAKE_DEPFILE_FLAGS_DPCPP "-MD -MT <OBJECT> -MF <DEPFILE>")

set(CMAKE_DPCPP_CREATE_PREPROCESSED_SOURCE "<CMAKE_DPCPP_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
set(CMAKE_DPCPP_CREATE_ASSEMBLY_SOURCE "<CMAKE_DPCPP_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
