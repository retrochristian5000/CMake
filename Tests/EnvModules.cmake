include(EnvModules)
if(ENV_MODULE_COMMAND)
  message("module purge:")
  env_module(COMMAND purge RESULT_VARIABLE ret_var)
  if(NOT ret_var EQUAL 0)
    message(FATAL_ERROR "module(purge) returned ${ret_var}")
  endif()
  message("No errors.")

  message("module avail:")
  env_module_avail(avail_mods)
  if(NOT avail_mods)
    message(FATAL_ERROR "No modules available")
  endif()
  message("No errors.")

  message("Available modules:")
  foreach(mod IN LISTS avail_mods)
    message("  ${mod}")
  endforeach()
else()
  message("No ENV_MODULE_COMMAND found")
endif()
