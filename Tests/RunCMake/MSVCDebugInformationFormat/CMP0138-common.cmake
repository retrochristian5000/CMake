enable_language(CXX)

cmake_policy(GET CMP0138 cmp0138)
if(cmp0138 STREQUAL "NEW")
  if(NOT " ${CMAKE_CXX_FLAGS_DEBUG} " MATCHES " -ZI ")
    message(SEND_ERROR "CMAKE_CXX_FLAGS_DEBUG does not have '-ZI' under NEW behavior")
  endif()
  if(NOT " ${CMAKE_CXX_FLAGS_RELWITHDEBINFO} " MATCHES " -ZI ")
    message(SEND_ERROR "CMAKE_CXX_FLAGS_RELWITHDEBINFO does not have '-ZI' under NEW behavior")
  endif()
else()
  if(NOT " ${CMAKE_CXX_FLAGS_DEBUG} " MATCHES " /Zi ")
    message(SEND_ERROR "CMAKE_CXX_FLAGS_DEBUG does not have '/Zi' under OLD behavior")
  endif()
  if(NOT " ${CMAKE_CXX_FLAGS_RELWITHDEBINFO} " MATCHES " /Zi ")
    message(SEND_ERROR "CMAKE_CXX_FLAGS_RELWITHDEBINFO does not have '/Zi' under OLD behavior")
  endif()
endif()
