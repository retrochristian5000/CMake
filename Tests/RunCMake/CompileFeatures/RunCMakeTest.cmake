configure_file("${RunCMake_SOURCE_DIR}/CMakeLists.txt" "${RunCMake_BINARY_DIR}/CMakeLists.txt" COPYONLY)

function(test_flags name lang ext)
  if(CMake_NO_${lang}_STANDARD)
    return()
  endif()

  set(standard_flag "${${lang}${${lang}_STANDARD_DEFAULT}_FLAG}")
  set(extension_flag "${${lang}${${lang}_STANDARD_DEFAULT}_EXT_FLAG}")

  if(NOT standard_flag AND NOT extension_flag)
    return()
  endif()

  set(test ${name}-${lang})
  set(standard_default "${${lang}_STANDARD_DEFAULT}")
  set(extensions_default "${${lang}_EXTENSIONS_DEFAULT}")
  configure_file("${RunCMake_SOURCE_DIR}/${name}.cmake" "${RunCMake_BINARY_DIR}/${test}.cmake" @ONLY)
  file(READ "${RunCMake_BINARY_DIR}/${test}.cmake" test_cmake)
  message("${RunCMake_BINARY_DIR}/${test}.cmake:\n${test_cmake}")
  configure_file("${RunCMake_SOURCE_DIR}/${name}-build-check.cmake" "${RunCMake_BINARY_DIR}/${test}-build-check.cmake" @ONLY)
  file(READ "${RunCMake_BINARY_DIR}/${test}-build-check.cmake" check_cmake)
  message("${RunCMake_BINARY_DIR}/${test}-build-check.cmake:\n${check_cmake}")

  set(RunCMake_SOURCE_DIR_REAL "${RunCMake_SOURCE_DIR}")
  set(RunCMake_SOURCE_DIR "${RunCMake_BINARY_DIR}")
  set(RunCMake_TEST_BINARY_DIR "${RunCMake_BINARY_DIR}/${test}-build")
  run_cmake(${test})
  set(RunCMake_TEST_NO_CLEAN 1)
  run_cmake_command(${test}-build ${CMAKE_COMMAND} --build . --verbose)
  file(READ "${RunCMake_TEST_BINARY_DIR}/CMakeFiles/${CMAKE_VERSION}/CMake${lang}Compiler.cmake" compiler)
  message("${RunCMake_TEST_BINARY_DIR}/CMakeFiles/${CMAKE_VERSION}/CMake${lang}Compiler.cmake:\n${compiler}")

  set(test defines-${lang})
  configure_file("${RunCMake_SOURCE_DIR_REAL}/defines.cmake" "${RunCMake_BINARY_DIR}/${test}.cmake" @ONLY)
  set(RunCMake_TEST_BINARY_DIR "${RunCMake_BINARY_DIR}/${test}-build")
  run_cmake(${test})

  message("${lang}_COMPILER_ID=${${lang}_COMPILER_ID}")
  if(${lang}_COMPILER_ID STREQUAL "Clang")
    if(${lang} STREQUAL C)
      set(flag -x c)
    else()
      set(flag -x c++)
    endif()
    execute_process(COMMAND ${${lang}_COMPILER} -E -dM ${flag} /dev/null OUTPUT_VARIABLE all_defines)
    message("all defines:\n${all_defines}")
  elseif(${lang}_COMPILER_ID STREQUAL "SunPro")
    execute_process(COMMAND ${${lang}_COMPILER} -E -xdumpmacros /dev/null OUTPUT_VARIABLE all_defines)
    message("all defines:\n${all_defines}")
  endif()
endfunction()

if(C_STANDARD_DEFAULT)
  test_flags(NoUnnecessaryFlag C c)
endif()

if(CXX_STANDARD_DEFAULT)
  run_cmake(NotAStandard)

  foreach(standard 98 11)
    if (CXX${standard}_FLAG STREQUAL NOTFOUND)
      run_cmake(RequireCXX${standard})
      run_cmake(RequireCXX${standard}Variable)
    endif()
    if (CXX${standard}_EXT_FLAG STREQUAL NOTFOUND)
      run_cmake(RequireCXX${standard}Ext)
      run_cmake(RequireCXX${standard}ExtVariable)
    endif()
  endforeach()

  #test_flags(NoUnnecessaryFlag CXX cpp)
endif()
