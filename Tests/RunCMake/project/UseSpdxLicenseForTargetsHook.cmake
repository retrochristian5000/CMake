set(CMAKE_PROJECT_HookA_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/UseSpdxLicenseForTargetsHook-a.cmake")
set(CMAKE_PROJECT_HookB_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/UseSpdxLicenseForTargetsHook-b.cmake")
project(HookA LANGUAGES NONE)
add_library(a_lib INTERFACE)
add_subdirectory(UseSpdxLicenseForTargetsHook-sub)

function(check_prop tgt expected)
  get_property(set TARGET ${tgt} PROPERTY SPDX_LICENSE SET)
  get_property(val TARGET ${tgt} PROPERTY SPDX_LICENSE)
  if(set AND NOT val STREQUAL expected)
    message(SEND_ERROR "${tgt}: expected SPDX_LICENSE '${expected}', got '${val}'")
  endif()
endfunction()
check_prop(a_lib "GPL-2.0-only")
check_prop(b_lib "")
