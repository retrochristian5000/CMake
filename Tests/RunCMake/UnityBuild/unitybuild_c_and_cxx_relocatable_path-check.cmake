  string(APPEND EXPECTED_UNITY_FILE_CONTENT "#include.*\"${rel_path}\".*")
endforeach()

file(STRINGS ${unitybuild_cxx} unitybuild_cxx_strings)
string(REGEX MATCH "${EXPECTED_UNITY_FILE_CONTENT_CXX}" matched_code ${unitybuild_cxx_strings})
