include(${CMAKE_CURRENT_LIST_DIR}/json.cmake)
# Test CALLBACK script. Prints output information and verifies index file
# Called as: cmake -P hook.cmake [CheckForStaticQuery?] [index.json]
set(index ${CMAKE_ARGV4})
set(hasStaticInfo ${CMAKE_ARGV3})
read_json(${index} contents)
string(JSON hook GET ${contents} hook)

# Output is verified by *-stdout.txt files that the HOOK is run
message(STATUS ${hook})
# Not a check-*.cmake script, this is called as an instrumentation CALLBACK
set(ERROR_MESSAGE "")

macro(has_key key json)
  unset(missingKey)
  string(JSON ${key} ERROR_VARIABLE missingKey GET ${json} ${key})
  if (NOT ${missingKey} MATCHES NOTFOUND)
    set(ERROR_MESSAGE "${ERROR_MESSAGE}\nKey \"${key}\" not in index:\n${json}")
  endif()
endmacro()

has_key(version ${contents})
has_key(buildDir ${contents})
has_key(dataDir ${contents})
has_key(snippets ${contents})

if (NOT ${version} EQUAL 1)
    set(ERROR_MESSAGE "${ERROR_MESSAGE}\nVersion must be 1, got: ${version}")
endif()

string(JSON length LENGTH ${snippets})
math(EXPR length ${length}-1)
foreach(i RANGE ${length})
  string(JSON filename GET ${snippets} ${i})
  if (NOT EXISTS ${dataDir}/${filename})
    set(ERROR_MESSAGE "${ERROR_MESSAGE}\nListed snippet: ${dataDir}/${filename} does not exist")
  endif()
endforeach()

if (${hasStaticInfo})
  has_key(staticSystemInformation ${contents})
  has_key(OSName ${staticSystemInformation})
  has_key(OSPlatform ${staticSystemInformation})
  has_key(OSRelease ${staticSystemInformation})
  has_key(OSVersion ${staticSystemInformation})
  has_key(familyId ${staticSystemInformation})
  has_key(hostname ${staticSystemInformation})
  has_key(is64Bits ${staticSystemInformation})
  has_key(modelId ${staticSystemInformation})
  has_key(numberOfLogicalCPU ${staticSystemInformation})
  has_key(numberOfPhysicalCPU ${staticSystemInformation})
  has_key(processorAPICID ${staticSystemInformation})
  has_key(processorCacheSize ${staticSystemInformation})
  has_key(processorClockFrequency ${staticSystemInformation})
  has_key(processorName ${staticSystemInformation})
  has_key(totalPhysicalMemory ${staticSystemInformation})
  has_key(totalVirtualMemory ${staticSystemInformation})
  has_key(vendorID ${staticSystemInformation})
  has_key(vendorString ${staticSystemInformation})
endif()

if (NOT ERROR_MESSAGE MATCHES "^$")
  message(FATAL_ERROR ${ERROR_MESSAGE})
endif()
