set(pgo_dir "${RunCMake_TEST_BINARY_DIR}/pgo")
set(exe_dir "${RunCMake_TEST_BINARY_DIR}")
if(RunCMake_GENERATOR_IS_MULTI_CONFIG)
  string(APPEND pgo_dir "/Release")
  string(APPEND exe_dir "/Release")
endif()
if(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
  set(merged "${pgo_dir}/main.pgd")
  set(raw "${exe_dir}/main!*.pgc")
else()
  set(merged "${pgo_dir}/default.profdata")
  set(raw "${pgo_dir}/*.profraw")
endif()
if(NOT EXISTS "${merged}")
  set(RunCMake_TEST_FAILED "Merged profile data not found:\n  ${merged}")
  return()
endif()
# The merged raw profile data is removed.
file(GLOB raw_files "${raw}")
if(raw_files)
  set(RunCMake_TEST_FAILED "Merged raw profile data not removed:\n  ${raw_files}")
endif()
