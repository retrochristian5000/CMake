set(pgo_dir "${RunCMake_TEST_BINARY_DIR}/pgo")
set(exe_dir "${RunCMake_TEST_BINARY_DIR}")
if(RunCMake_GENERATOR_IS_MULTI_CONFIG)
  string(APPEND pgo_dir "/Release")
  string(APPEND exe_dir "/Release")
endif()
if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
  set(pattern "${pgo_dir}/*.gcda")
elseif(CMAKE_C_COMPILER_ID MATCHES "Clang")
  set(pattern "${pgo_dir}/*.profraw")
elseif(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
  # The instrumented binaries write '<pgd-name>!<n>.pgc' files next to
  # themselves.
  set(pattern "${exe_dir}/main!*.pgc")
else()
  return()
endif()
file(GLOB_RECURSE profile_data "${pattern}")
if(NOT profile_data)
  set(RunCMake_TEST_FAILED "No profile data found:\n  ${pattern}")
endif()
