file(GLOB scripts "${RunCMake_TEST_BINARY_DIR}/CMakeFiles/cmake_pgo_merge*.cmake")
if(NOT scripts)
  set(RunCMake_TEST_FAILED "The cmake_pgo_merge script was not generated.")
  return()
endif()
foreach(script IN LISTS scripts)
  file(READ "${script}" content)
  if(NOT content MATCHES "Merging profile data")
    set(RunCMake_TEST_FAILED "The script\n  ${script}\ndoes not merge profile data:\n${content}")
    return()
  endif()
endforeach()
