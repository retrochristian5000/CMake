enable_language(CXX)

cmake_policy(GET CMP0171 cmp0171)
if(cmp0171 STREQUAL "NEW")
  if(NOT CMAKE_MSVC_INCREMENTAL_LINK_DEFAULT)
    message(SEND_ERROR "CMAKE_MSVC_INCREMENTAL_LINK_DEFAULT not set under NEW behavior")
  endif()
else()
  if(CMAKE_MSVC_INCREMENTAL_LINK_DEFAULT)
    message(SEND_ERROR "CMAKE_MSVC_INCREMENTAL_LINK_DEFAULT is set under OLD behavior")
  endif()
endif()

if(cmp0171 STREQUAL "NEW")
  if(CMAKE_EXE_LINKER_FLAGS_DEBUG MATCHES "[/-]INCREMENTAL(:YES|:NO)?( |$)")
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_DEBUG has -INCREMENTAL flags under NEW behavior.")
  endif()
  if(CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO MATCHES "[/-]INCREMENTAL(:YES|:NO)?( |$)")
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO has -INCREMENTAL flags under NEW behavior.")
  endif()
else()
  if(NOT (CMAKE_EXE_LINKER_FLAGS_DEBUG MATCHES "[/-]INCREMENTAL(:YES)?( |$)"))
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_DEBUG does not have -INCREMENTAL flags under OLD behavior.")
  endif()
  if(NOT (CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO MATCHES "[/-]INCREMENTAL(:YES)?( |$)"))
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO does not have -INCREMENTAL flags under OLD behavior.")
  endif()
  if(NOT (CMAKE_EXE_LINKER_FLAGS_RELEASE MATCHES "[/-]INCREMENTAL:NO( |$)"))
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_RELEASE does not have -INCREMENTAL:NO flag under OLD behavior.")
  endif()
  if(NOT (CMAKE_EXE_LINKER_FLAGS_MINSIZEREL MATCHES "[/-]INCREMENTAL:NO( |$)"))
    message(SEND_ERROR "CMAKE_EXE_LINKER_FLAGS_MINSIZEREL does not have -INCREMENTAL:NO flag under OLD behavior.")
  endif()
endif()

set(CMAKE_MSVC_INCREMENTAL_LINK BogusValue)
add_library(foo SHARED empty.cxx)
