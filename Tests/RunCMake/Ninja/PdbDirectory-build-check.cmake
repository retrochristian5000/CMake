foreach(target IN ITEMS slash backslash namedSlash namedBackslash default)
  if(target STREQUAL "default")
    set(dir "${RunCMake_TEST_BINARY_DIR}/CMakeFiles/default.dir${pdb_suffix}")
  else()
    set(dir "${RunCMake_TEST_BINARY_DIR}/pdb space/${target}/nested${pdb_suffix}")
  endif()
  if(target MATCHES "^named")
    set(pdbs "${dir}/named-control.pdb")
  else()
    # The compiler chooses its version-dependent default filename.
    file(GLOB pdbs "${dir}/*.pdb")
    if(NOT pdbs)
      string(APPEND RunCMake_TEST_FAILED "Missing compiler PDB in: ${dir}\n")
    endif()
  endif()
  foreach(pdb IN LISTS pdbs)
    if(NOT EXISTS "${pdb}" OR IS_DIRECTORY "${pdb}")
      string(APPEND RunCMake_TEST_FAILED "Missing compiler PDB file: ${pdb}\n")
    else()
      file(SIZE "${pdb}" size)
      if(size EQUAL 0)
        string(APPEND RunCMake_TEST_FAILED "Empty compiler PDB file: ${pdb}\n")
      endif()
    endif()
  endforeach()
endforeach()
