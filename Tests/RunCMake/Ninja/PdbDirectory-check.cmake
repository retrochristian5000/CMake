foreach(target IN ITEMS slash backslash namedSlash namedBackslash)
  set(dir "${RunCMake_TEST_BINARY_DIR}/pdb space/${target}/nested${pdb_suffix}")
  if(NOT IS_DIRECTORY "${dir}")
    string(APPEND RunCMake_TEST_FAILED "Missing compiler PDB directory: ${dir}\n")
  endif()
  if(IS_DIRECTORY "${dir}/named-control.pdb")
    string(APPEND RunCMake_TEST_FAILED "Filename-form /Fd created a directory: ${dir}/named-control.pdb\n")
  endif()
endforeach()
