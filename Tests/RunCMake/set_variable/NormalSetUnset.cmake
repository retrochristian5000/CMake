
set_variable(VAR1 VALUES v1 v2)
if(NOT DEFINED VAR1)
  message(SEND_ERROR "VAR1 not defined")
endif()
set_variable(VAR1 VALUES v1 v2)
if(NOT VAR1 STREQUAL "v1;v2")
  message(SEND_ERROR "VAR1 value should be \"v1;v2\", not \"${VAR1}\"")
endif()
set_variable(VAR1 VALUES v3 v4)
if(NOT VAR1 STREQUAL "v3;v4")
  message(SEND_ERROR "VAR1 value should be \"v3;v4\", not \"${VAR1}\"")
endif()
set_variable(VAR1 VALUES)
if(NOT DEFINED VAR1)
  message(SEND_ERROR "VAR1 not defined")
endif()
if(NOT VAR1 STREQUAL "")
  message(SEND_ERROR "VAR1 value should be \"\", not \"${VAR1}\"")
endif()

unset_variable(VAR1)
if(DEFINED VAR1)
  message(SEND_ERROR "VAR1 defined")
endif()
