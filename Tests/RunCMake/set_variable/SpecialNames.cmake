
#
# Check that variable names and values can be freely chosen
#

block()
  set_variable(VALUES VALUES SCOPE LOCAL PARENT TYPE HELP)
  set_variable(SCOPE SCOPE LOCAL VALUES SCOPE LOCAL PARENT TYPE HELP)
  set_variable(LOCAL SCOPE LOCAL VALUES SCOPE LOCAL PARENT TYPE HELP)
  set_variable(TYPE SCOPE PARENT VALUES SCOPE LOCAL PARENT TYPE HELP)

  set_variable(CACHE{VALUES} VALUES LOCAL PARENT TYPE HELP)
  set_variable(CACHE{SCOPE} TYPE STRING VALUES LOCAL PARENT TYPE HELP)
  set_variable(CACHE{LOCAL} TYPE STRING VALUES LOCAL PARENT TYPE HELP)
  set_variable(CACHE{TYPE} HELP "help" VALUES LOCAL PARENT TYPE HELP)

  set_variable(ENV{VALUES} VALUES TYPE)
  set_variable(ENV{SCOPE} VALUES HELP)
  set_variable(ENV{LOCAL} VALUES SCOPE)
  set_variable(ENV{TYPE} VALUES LOCAL)
endblock()
