  message(SEND_ERROR "END{CMAKE_VAR1} not defined")
endif()
if(NOT "$ENV{CMAKE_VAR1}" STREQUAL "v1")
  message(SEND_ERROR "ENV{CMAKE_VAR1} value should be \"v1\", not \"$ENV{CMAKE_VAR1}\"")
endif()

set_variable(ENV{CMAKE_VAR1} VALUES)
