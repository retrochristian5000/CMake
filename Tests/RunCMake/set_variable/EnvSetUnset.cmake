  if(NOT DEFINED ENV{CMAKE_VAR1})
    message(SEND_ERROR "ENV{CMAKE_VAR1} not defined")
  endif()
endif()
if(NOT "$ENV{CMAKE_VAR1}" STREQUAL "")
