include(RunCMake)

function(run_StdLatest lang)
  if(CMake_NO_${lang}_STANDARD)
    return()
  endif()
  set(RunCMake_TEST_BINARY_DIR ${RunCMake_BINARY_DIR}/StdLatest-${lang}-build)
  run_cmake(StdLatest-${lang})
  set(RunCMake_TEST_NO_CLEAN 1)
  run_cmake_command(StdLatest-${lang}-build ${CMAKE_COMMAND} --build .)
endfunction()
run_StdLatest(C)
run_StdLatest(CXX)
if(CMake_TEST_CUDA)
  run_StdLatest(CUDA)
endif()
if(CMake_TEST_HIP)
  run_StdLatest(HIP)
endif()
if(CMake_TEST_OBJC)
  run_StdLatest(OBJC)
  run_StdLatest(OBJCXX)
endif()
