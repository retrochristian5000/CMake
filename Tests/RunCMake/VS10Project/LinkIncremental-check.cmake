macro(LinkIncremental_check tgt Debug_expect Release_expect MinSizeRel_expect RelWithDebInfo_expect)
  set(vcProjectFile "${RunCMake_TEST_BINARY_DIR}/${tgt}.vcxproj")
  if(NOT EXISTS "${vcProjectFile}")
    set(RunCMake_TEST_FAILED "Project file ${tgt}.vcxproj does not exist.")
    return()
  endif()

  set(Debug_actual "")
  set(Release_actual "")
  set(MinSizeRel_actual "")
  set(RelWithDebInfo_actual "")

  file(STRINGS "${vcProjectFile}" lines)
  foreach(line IN LISTS lines)
    if(line MATCHES "^ *<LinkIncremental Condition=\"'\\$\\(Configuration\\)\\|\\$\\(Platform\\)'=='([^<>]+)\\|[A-Za-z0-9_]+'\">([^<>]+)</LinkIncremental>")
      message("Matched line: ${line}")
      message("Results: ${CMAKE_MATCH_1} ${CMAKE_MATCH_2}")
      set(Configuration "${CMAKE_MATCH_1}")
      set(${Configuration}_actual "${CMAKE_MATCH_2}")
    endif()
  endforeach()

  if (NOT "${Debug_actual}" STREQUAL "${Debug_expect}")
    string(APPEND RunCMake_TEST_FAILED "Project file ${tgt}.vcxproj Debug Configuration has LinkIncremental '${Debug_actual}', not '${Debug_expect}'.\n")
  endif()
  if (NOT "${Release_actual}" STREQUAL "${Release_expect}")
    string(APPEND RunCMake_TEST_FAILED "Project file ${tgt}.vcxproj Release Configuration has LinkIncremental '${Release_actual}', not '${Release_expect}'.\n")
  endif()
  if (NOT "${MinSizeRel_actual}" STREQUAL "${MinSizeRel_expect}")
    string(APPEND RunCMake_TEST_FAILED "Project file ${tgt}.vcxproj MinSizeRel Configuration has LinkIncremental '${MinSizeRel_actual}', not '${MinSizeRel_expect}'.\n")
  endif()
  if (NOT "${RelWithDebInfo_actual}" STREQUAL "${RelWithDebInfo_expect}")
    string(APPEND RunCMake_TEST_FAILED "Project file ${tgt}.vcxproj RelWithDebInfo Configuration has LinkIncremental '${RelWithDebInfo_actual}', not '${RelWithDebInfo_expect}'.\n")
  endif()
endmacro()

LinkIncremental_check(cmake-default-C "true" "false" "false" "true")
LinkIncremental_check(cmake-default-CXX "true" "false" "false" "true")
LinkIncremental_check(empty-C "true" "true" "true" "true")
LinkIncremental_check(empty-CXX "true" "true" "true" "true")
LinkIncremental_check(Force-C "true" "true" "true" "true")
LinkIncremental_check(Force-CXX "true" "true" "true" "true")
LinkIncremental_check(Default-C "true" "true" "true" "true")
LinkIncremental_check(Default-CXX "true" "true" "true" "true")
LinkIncremental_check(Never-C "false" "false" "false" "false")
LinkIncremental_check(Never-CXX "false" "false" "false" "false")
