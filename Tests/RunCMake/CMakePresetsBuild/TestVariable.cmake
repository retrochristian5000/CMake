function(test_environment_variable name expected_value)
    string(REGEX MATCH "${name}=([^\r\n]*)" REGEX_RESULT "${actual_stdout}")
    if(NOT REGEX_RESULT)
        message(SEND_ERROR "Environment variable '${name}' is not defined.")
    else()
        set(actual_value "${CMAKE_MATCH_1}")
        if(NOT "${actual_value}" MATCHES "${expected_value}")
            message(SEND_ERROR "Expected value of environment variable '${name}': \"${expected_value}\"\nActual value: \"${actual_value}\"")
        endif()
    endif()
endfunction()
