{
    "version": 4,
    "configurePresets": [
        {
            "name": "PathSep",
            "generator": "@RunCMake_GENERATOR@",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "TEST_PATH_SEP": "${sourceDir}${pathSep}${sourceDir}"
            }
        }
    ]
}
