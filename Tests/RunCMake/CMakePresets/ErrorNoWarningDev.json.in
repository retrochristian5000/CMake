{
  "version": {
    "major": 1,
    "minor": 0
  },
  "configurePresets": [
    {
      "name": "ErrorNoWarningDev",
      "generator": "@RunCMake_GENERATOR@",
      "binaryDir": "${sourceDir}/build",
      "warnings": {
        "dev": false
      },
      "errors": {
        "dev": true
      }
    }
  ]
}
