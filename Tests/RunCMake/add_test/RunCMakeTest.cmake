include(RunCTest)
include("${RunCMake_SOURCE_DIR}/TestConfig.cmake")

set(ENV{CTEST_OUTPUT_ON_FAILURE} 1)

unset(NAMES_OF_TEST_CASES)
list(APPEND NAMES_OF_TEST_CASES

    NameIsAlphaNumeric1
    NameIsAlphaNumeric2
    NameIsAlphaNumeric3
    NameIsAlphaNumeric4

    NameContainsValidSpecialChars1
    NameContainsValidSpecialChars2
    NameContainsValidSpecialChars3
    NameContainsValidSpecialChars4

    NameContainsFormerInvalidSpecialChars1
    NameContainsFormerInvalidSpecialChars2
    NameContainsFormerInvalidSpecialChars3
    NameContainsFormerInvalidSpecialChars4

    NameContainsOtherSpecialChars1
    NameContainsOtherSpecialChars2
    NameContainsOtherSpecialChars3
    NameContainsOtherSpecialChars4

    NameContainsEscapedSpecialChars1
    NameContainsEscapedSpecialChars2
    NameContainsEscapedSpecialChars3
    NameContainsEscapedSpecialChars4

    NameContainsSpaces1
    NameContainsSpaces2
    NameContainsSpaces3
    NameContainsSpaces4

    NameContainsEscapedLeadingAndTrailingWhitespace1
    NameContainsEscapedLeadingAndTrailingWhitespace2
    NameContainsEscapedLeadingAndTrailingWhitespace3
    NameContainsEscapedLeadingAndTrailingWhitespace4

    NameContainsSemicolon1
    NameContainsSemicolon2
    NameContainsSemicolon3
    NameContainsSemicolon4

    NameContainsEscapedQuote1
    NameContainsEscapedQuote2
    NameContainsEscapedQuote3
    NameContainsEscapedQuote4

    NameContainsBracketArgument1
    NameContainsBracketArgument2
    NameContainsBracketArgument3
    NameContainsBracketArgument4
)


# CMP0110 is set to NEW:
foreach(CASE_NAME ${NAMES_OF_TEST_CASES})
  prepare_test(${CASE_NAME})
  set(INSERTED_POLICY "cmake_policy(SET CMP0110 NEW)")
  run_ctest(CMP0110-NEW-${CASE_NAME}-ctesting)
endforeach()

#CMP0110 is set to OLD:
foreach(CASE_NAME ${NAMES_OF_TEST_CASES})
  prepare_test(${CASE_NAME})
  set(INSERTED_POLICY "cmake_policy(SET CMP0110 OLD)")
  run_ctest(CMP0110-OLD-${CASE_NAME}-ctesting)
endforeach()

# CMP0110 is NOT set:
foreach(CASE_NAME ${NAMES_OF_TEST_CASES})
  prepare_test(${CASE_NAME})
  set(INSERTED_POLICY "# Policy CMP0110 is unset on purpose!")
  # As side-effect, will generate CMakeLists.txt in its build-directory.
  run_ctest(CMP0110-WARN-${CASE_NAME}-ctesting)
  # Use the CMakeLists.txt generated by `run_ctest`.
  set(RunCMake_TEST_SOURCE_DIR ${RunCMake_BINARY_DIR}/CMP0110-WARN-${CASE_NAME}-ctesting)
  run_cmake(CMP0110-WARN-${CASE_NAME}-cmaking)
endforeach()
